cabal-version: 2.4
name: incident-wiki
version: 0.1.0.0
build-type: Simple
license: CC0-1.0

executable site
  main-is: site.hs
  build-depends:
      base >= 4.18 && < 5
    , filepath >= 1.4 && < 1.6
    , hakyll >= 4.17 && < 4.18
  ghc-options: -Wall -threaded -rtsopts
  default-language: Haskell2010
